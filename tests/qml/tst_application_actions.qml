pragma ComponentBehavior: Bound
import QtQuick
import Shelllist.Io as Io
import "../../launcher" as Apps
import "../../launcher/AppApi.js" as Api

DaemonTestCase {
    id: testCase
    name: "ApplicationActions"
    when: windowShown
    visible: true
    width: 1200
    height: 800

    Component {
        id: surfaceComponent
        Apps.ApplicationContent {
            id: surface
            width: testCase.width
            height: testCase.height
            property int dismissals: 0
            property var failures: []
            controller: Apps.ApplicationController {
                onCloseWindowRequested: {
                    surface.dismissals++;
                    deactivateUi();
                }
                onBackgroundActionFailed: function(title, message) {
                    surface.failures = surface.failures.concat([{title: title, message: message}]);
                }
            }
        }
    }
    function application(id, windows) {
        return {id: id, name: id, kind: "desktop-application", revision: 1,
            running: windows.length > 0, focused: false,
            instances: windows.map(w => ({id: w, title: w, workspace_id: "1"})),
            desktop_actions: [], category: "shell"};
    }
    function makePanel(desktopActions) {
        const panel = createTemporaryObject(surfaceComponent, testCase);
        verify(panel !== null);
        const c = panel.controller;
        c.activateUiState("1");
        const alpha = application("Alpha", ["w1", "w2"]);
        alpha.desktop_actions = desktopActions || [];
        c.replaceProviderResults([alpha, application("Beta", ["w3"])].map(a => c.provider.resultFor(a)), true);
        tryVerify(() => c.hasSelection && panel.listItem !== null);
        c.select(c.filteredResults.findIndex(r => r.id === "Alpha"));
        tryCompare(c.selectedResult, "id", "Alpha");
        panel.listItem.focusList();
        calls = [];
        return panel;
    }
    function lastCall(method) {
        const matches = calls.filter(call => call.method === method);
        verify(matches.length > 0, "Missing " + method);
        return matches[matches.length - 1];
    }
    function reply(call, data, error) {
        Io.DaemonSessions.sessions["app-daemon"].client.response(call.id,
            {protocol: Api.protocol, version: Api.version, ok: !error, data: data}, error || "", call.route);
    }
    function operation(call, status, extra) {
        const request = new XMLHttpRequest();
        request.open("GET", Qt.resolvedUrl("fixtures/" + (status === "accepted" ? "app-replies.json" : "app-events.json")), false);
        request.send();
        const fixture = JSON.parse(request.responseText);
        const native = status === "accepted" ? fixture["applications.execute"].data.operation : fixture[status].data.operation;
        return Object.assign({}, native, {id: "op-" + call.id, target_id: call.params.target_id,
            action: call.params.action, message: status}, extra || {});
    }
    function accept(call) { reply(call, {operation: operation(call, "accepted")}); }
    function event(call, status, extra) {
        Io.DaemonSessions.sessions["app-daemon"].client.eventReceived({protocol: Api.protocol,
            version: Api.version, stream: Api.streams.operation, event: status,
            data: {operation: operation(call, status, extra)}}, null);
    }
    // Generated by app-daemon debug event-contract-fixture. Never reconstruct
    // valid wire envelopes here: only synthetic invalid cases do so.
    function snapshot(panel, windows, background) {
        panel.controller.refresh(false);
        reply(lastCall(Api.methods.query), {applications: {revision: 2, hyprland_available: true,
            applications: [Object.assign(application("Alpha", windows), {running: !!background || windows.length > 0}), application("Beta", ["w3"])]}});
        wait(0);
    }
    function expand(panel) {
        keyClick(Qt.Key_Right);
        tryCompare(panel.controller, "detailsOpen", true);
        tryVerify(() => findChild(panel, "closeWindow-w1") !== null);
        waitForRendering(panel);
    }
    function verifyStatus(panel, message) {
        const label = findChild(panel.listItem, "feedbackText");
        verify(label !== null && label.visible);
        tryCompare(label, "text", message);
    }
    function test_sectionHeadingsStayInsideCardsAndOutsideFieldTraversal() {
        const panel = makePanel([{id: "new-private", name: "New Private Window"}]);
        expand(panel);
        for (const entry of [
            {card: "applicationWindowsCard", title: "Open windows · 2", content: "windowRow-w1"},
            {card: "applicationActionsCard", title: "Application actions · 1", content: "desktopAction-new-private"}
        ]) {
            const card = findChild(panel, entry.card);
            verify(card !== null && card.visible);
            const heading = findChild(card, "sectionHeadingText");
            compare(heading.text, entry.title);
            const content = findChild(card, entry.content);
            verify(content !== null);
            // Nested layouts/positioners can need another polish pass after
            // the first rendered frame. Wait for the geometry, not a delay.
            tryVerify(() => {
                const position = heading.mapToItem(card, 0, 0);
                return position.x > 0 && position.y > 0
                    && position.x + heading.width <= card.width
                    && position.y + heading.height < card.height
                    && content.mapToItem(card, 0, 0).y >= position.y + heading.height;
            }, 5000, entry.card + ": inset heading must precede content inside the card");
        }
        keyClick(Qt.Key_Tab);
        compare(panel.detailsNavigation.availableFields().length, 0, "headings remain passive");
        compare(panel.detailsNavigation.currentTarget.objectName, "applicationPage");
        keyClick(Qt.Key_PageDown);
        compare(calls.filter(call => call.method === Api.methods.execute).length, 0);
        const action = findChild(panel, "desktopAction-new-private");
        findChild(panel, "applicationPage").revealItem(action);
        waitForRendering(panel);
        mouseClick(action.button);
        const call = lastCall(Api.methods.execute);
        compare(call.params.action, "desktop-action");
        compare(call.params.desktop_action_id, "new-private");
    }
    function test_close_usesNativeObservationAndRestoresCommandFocus() {
        const panel = makePanel();
        const c = panel.controller;
        expand(panel);
        mouseClick(findChild(panel, "closeWindow-w1"));
        verify(!panel.detailsNavigation.commandMenuOpen);
        const call = lastCall(Api.methods.execute);
        compare(call.params.window_id, "w1");
        compare(call.params.action, "close-window");
        verifyStatus(panel, "Closing window of Alpha…");
        accept(call);
        verifyStatus(panel, "Closing window of Alpha…");
        verify(!findChild(panel, "closeWindow-w1").enabled);
        mouseClick(findChild(panel, "closeWindow-w1"));
        mouseClick(findChild(panel, "focusWindow-w1"));
        compare(calls.filter(c => c.method === Api.methods.execute).length, 1, "Pending close blocks conflicting pointer commands");
        event(call, "completed", {message: "Close requested; 1 window still open. Focus it to check for a save prompt.",
            close: {status: "still-open", targeted_window_ids: ["w1"], dispatched_window_ids: ["w1"], remaining_window_ids: ["w1"], dispatch_error: null}});
        compare(panel.dismissals, 0);
        compare(c.selectedApplication.instances.length, 2, "Native observation must not rewrite the catalog");
        snapshot(panel, ["w1", "w2"]);
        verify(c.selectedActionMessage.indexOf("still open") >= 0);
        verify(findChild(panel, "focusWindow-w1").enabled, "Can reach a save prompt");
        // Put real native focus on the row command before removing that row.
        findChild(panel, "closeWindow-w1").forceActiveFocus();
        snapshot(panel, ["w2"]);
        verify(c.selectedActionMessage.indexOf("still open") >= 0, "filtered catalog changes must not rewrite the native outcome");
        compare(c.selectedApplication.instances.length, 1);
        verify(panel.detailsNavigation.activeFocus, "Removed command returns to shared browsing");
        compare(c.selectedResult.id, "Alpha");
        keyClick(Qt.Key_C, Qt.AltModifier);
        const all = lastCall(Api.methods.execute);
        compare(all.params.action, "close");
        verifyStatus(panel, "Closing windows of Alpha…");
        compare(c.detailActions.find(a => a.id === "close").label, "Close all windows (1)");
        accept(all);
        event(all, "completed", {message: "Requested windows closed",
            close: {status: "closed", targeted_window_ids: ["w2"], dispatched_window_ids: ["w2"], remaining_window_ids: [], dispatch_error: null}});
        snapshot(panel, [], true);
        verify(c.selectedApplication.running, "Background processes may survive closing all windows");
        compare(c.detailActions.find(a => a.id === "activate").label, "Launch");
        verify(findChild(panel, "applicationEmptyState").text.indexOf("No open windows") === 0);
        verify(!c.detailActions.find(a => a.id === "close").enabled);
        verify(c.selectedActionMessage.indexOf("windows closed") >= 0);
        verifyStatus(panel, "Requested windows closed");
        compare(panel.dismissals, 0);
        keyClick(Qt.Key_A, Qt.AltModifier);
        compare(lastCall(Api.methods.execute).params.action, "activate", "Launch remains reachable after the last close");
    }
    function test_closeCanonicalAction_data() {
        const cases = [];
        for (const action of ["close", "close-window-0"]) {
            for (const outcome of ["closed", "still-open", "unknown", "missing", "malformed", "failed", "cancelled"])
                cases.push({tag: action + "-" + outcome, action: action, outcome: outcome});
        }
        return cases;
    }
    function test_closeCanonicalAction(data) {
        const panel = makePanel();
        const c = panel.controller;
        verify(c.triggerDetailAction(data.action));
        const call = lastCall(Api.methods.execute);
        compare(c.operations.forTarget("Alpha").request.operationAction, call.params.action);
        accept(call);
        // Close never inherits handoff authority from irrelevant launch metadata.
        const launch = {launch_backend: "uwsm", launch_scope: "fixture.scope", revision: 2};
        event(call, "running", Object.assign({}, launch, {action: "launch"}));
        event(call, "running", Object.assign({}, launch, {target_id: "Beta"}));
        event(call, "running", Object.assign({}, launch, {id: "foreign-operation"}));
        compare(c.operations.forTarget("Alpha").revision, 1);
        event(call, "running", launch);
        compare(c.operations.forTarget("Alpha").revision, 2);
        compare(panel.dismissals, 0);
        const targets = call.params.window_id ? [call.params.window_id] : ["w1", "w2"];
        const observation = data.outcome === "missing" ? undefined : data.outcome === "malformed" ? {} : {
            status: ["failed", "cancelled"].includes(data.outcome) ? "unknown" : data.outcome,
            targeted_window_ids: targets, dispatched_window_ids: targets,
            remaining_window_ids: data.outcome === "closed" ? [] : targets, dispatch_error: null
        };
        const status = ["failed", "cancelled"].includes(data.outcome) ? data.outcome : "completed";
        // A captured status read can finish after browsing away and reopening.
        c.operations.check("Alpha");
        const read = lastCall(Api.methods.operationStatus);
        c.select(c.filteredResults.findIndex(r => r.id === "Beta"));
        keyClick(Qt.Key_Escape);
        compare(panel.dismissals, 1);
        c.activateUiState("1");
        const terminal = Object.assign({}, launch, {revision: 3, close: observation});
        reply(read, {operation_status: operation(call, status, terminal)});
        verify(!c.operations.busy("Alpha"));
        compare(panel.dismissals, 1);
        verify(c.uiActive);
        compare(c.filteredResults.find(r => r.id === "Alpha").payload.instances.length, 2);
        const feedback = JSON.stringify(c.operations.feedback.Alpha);
        event(call, status, terminal);
        event(call, "running", {revision: 4});
        compare(JSON.stringify(c.operations.feedback.Alpha), feedback, "late outcomes cannot reopen or rewrite retired work");
        compare(calls.filter(call => call.method === Api.methods.execute).length, 1);
        c.select(c.filteredResults.findIndex(r => r.id === "Alpha"));
        verify(c.triggerDetailAction(data.action), "only explicit retry starts another Close");
        compare(calls.filter(call => call.method === Api.methods.execute).length, 2);
        const retry = lastCall(Api.methods.execute);
        accept(retry);
        event(call, status, Object.assign({}, terminal, {revision: 99}));
        compare(c.operations.forTarget("Alpha").operationId, operation(retry, "accepted").id,
            "a late old receipt cannot retire the explicit retry");
    }
    function test_reopenedPanelIsNotDismissedByOldOperation() {
        const panel = makePanel();
        keyClick(Qt.Key_Return);
        const call = lastCall(Api.methods.execute);
        accept(call);
        keyClick(Qt.Key_Escape);
        compare(panel.dismissals, 1);
        verify(panel.controller.actionInFlight);
        panel.controller.activateUiState("1");
        event(call, "completed");
        compare(panel.dismissals, 1);
        verify(panel.controller.uiActive);
        verify(!panel.controller.actionInFlight);
    }
    function test_statusRecoveryIsOwnedReadOnlyAndDoesNotReplay() {
        const panel = makePanel();
        const c = panel.controller;
        verify(c.triggerDetailAction("close"));
        const call = lastCall(Api.methods.execute);
        // An early event is not trusted without the admission/owned read.
        event(call, "completed");
        verify(c.actionInFlight);
        accept(call);
        expand(panel);
        // Recovery is automatic, not a user command.
        tryVerify(() => calls.some(call => call.method === Api.methods.operationStatus));
        const check = lastCall(Api.methods.operationStatus);
        compare(check.params.operation_id, operation(call, "accepted").id);
        reply(check, {operation_status: operation(call, "completed", {target_id: "foreign"})});
        verify(c.actionInFlight);
        c.operations.check("Alpha");
        reply(lastCall(Api.methods.operationStatus), {operation_status: operation(call, "completed")});
        verify(!c.actionInFlight);
        compare(c.selectedApplication.instances.length, 2);
        compare(calls.filter(call => call.method === Api.methods.execute).length, 1);
    }
    function test_nativeOperationRevisionFencesStatusEventsAndQuietTerminalRecovery() {
        const panel = makePanel();
        const c = panel.controller;
        verify(c.triggerDetailAction("close"));
        const call = lastCall(Api.methods.execute);
        accept(call);
        c.operations.check("Alpha");
        const captured = lastCall(Api.methods.operationStatus);
        event(call, "running", {revision: 3, message: "new observation"});
        reply(captured, {operation_status: operation(call, "running", {revision: 2})});
        compare(c.operations.forTarget("Alpha").revision, 3);
        event(call, "running", {revision: 2});
        event(call, "running", {revision: 3});
        compare(c.operations.forTarget("Alpha").revision, 3);
        // Terminal delivery is lost with no later event. The owned status read
        // converges; old traffic cannot revive a terminal operation.
        c.operations.check("Alpha");
        reply(lastCall(Api.methods.operationStatus), {operation_status: operation(call, "completed", {revision: 4})});
        verify(!c.operations.busy("Alpha"));
        event(call, "running", {revision: 3});
        verify(!c.operations.busy("Alpha"));
        compare(calls.filter(call => call.method === Api.methods.execute).length, 1);
    }
    function test_missingNativeOperationRevisionLeavesOutcomeUnknownWithoutReplay() {
        const panel = makePanel();
        const c = panel.controller;
        verify(c.triggerDetailAction("close"));
        const call = lastCall(Api.methods.execute);
        reply(call, {operation: operation(call, "accepted", {revision: undefined})});
        verify(!c.operations.busy("Alpha"));
        verify(c.operations.feedback.Alpha.message.includes("matching daemon required"));
        verify(c.operations.feedback.Alpha.message.includes("outcome unknown"));
        compare(calls.filter(call => call.method === Api.methods.execute).length, 1);
    }
    function test_malformedStatusRetiresOnlyItsReadAndAllowsRecovery() {
        const panel = makePanel();
        const c = panel.controller;
        verify(c.triggerDetailAction("close"));
        const call = lastCall(Api.methods.execute);
        accept(call);
        const original = JSON.stringify(c.operations.pending);
        c.applyOperation("", null);
        verify(!c.operations.finishStatus("", null, "Unowned error"));
        compare(JSON.stringify(c.operations.pending), original);
        let previous = null;
        for (const data of [{}, {operation_status: null}, {operation_status: {}}]) {
            c.operations.check("Alpha");
            const read = lastCall(Api.methods.operationStatus);
            if (previous) {
                verify(read.id !== previous.id);
                const requestId = c.operations.forTarget("Alpha").statusRequestId;
                reply(previous, {}, "Obsolete read failure");
                compare(c.operations.forTarget("Alpha").statusRequestId, requestId);
            }
            reply(read, data);
            compare(c.operations.forTarget("Alpha").statusRequestId, "");
            verify(c.operations.busy("Alpha"), "An empty status is not mutation completion");
            compare(panel.dismissals, 0);
            previous = read;
        }
        c.operations.check("Alpha");
        reply(lastCall(Api.methods.operationStatus), {operation_status: operation(call, "completed")});
        verify(!c.operations.busy("Alpha"));
        compare(calls.filter(call => call.method === Api.methods.execute).length, 1);
    }
}
