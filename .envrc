# All consumers follow this one current framework; never persist local pins.
local_inputs=()
for project in daemon-framework shelllist-hyprland app-daemon bar-daemon bt-daemon clip-daemon nm-daemon; do
  watch_file "../$project/flake.nix"
  local_inputs+=(--override-input "$project" "git+file://$(realpath "../$project")")
done
use flake . --no-write-lock-file "${local_inputs[@]}"
unset local_inputs project
