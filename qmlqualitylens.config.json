  "output_dir": "target/qmlqualitylens",
  "profile": "quickshell",
  "external_modules": ["QtTest"],
  "external_types": ["GlobalShortcut", "IconImage", "IpcHandler", "PanelWindow", "RectangularShadow", "Region", "ScriptAction", "Settings", "Shortcut", "SignalSpy", "TestCase", "TextMetrics", "Variants"],
  "reports": {
    "qmlbench": "target/performance/qmlbench.json",
    "coverage": "target/profiling/coverage.json",
    "qml_profiler": "target/profiling/runtime.json"
  },
  "benchmark_policy": {
    "max_regression_percent": 10,
    "max_coefficient_of_variation": 0.20,
    "min_samples": 10
  },
  "tools": {
    "parser_oracle": {
      "check": true,
      "qmldom_command": "qmldom",
      "tree_sitter": true
    },
    "qmlformat": {
      "check": true,
      "command": "qmlformat"
    },
    "qmllint": {
      "command": "tests/run-qmlquality-lint.sh",
      "check": true,
      "import_paths": ["qml"]
    },
    "qmltestrunner": {
      "command": "tests/profile-qml.py",
      "check": true,
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    "runtime": {
      "command": "bash",
      "check": true,
      "arguments": ["tests/run-runtime-smoke.sh"],
      "timeout_ms": 30000
    }
  },
  "suppressions": [],
  "exclude": []
}
