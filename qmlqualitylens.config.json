{
  "project_name": "shelllist",
  "project_root": ".",
  "source_roots": ["bar", "shell", "wifi", "bluetooth", "clipboard", "launcher", "activity", "qml", "tests/qml"],
  "entrypoints": [
    "shell/shell.qml",
    "tests/qml/tst_hyprland_dispatch.qml",
    "tests/qml/tst_ip_settings_state.qml",
    "tests/qml/tst_jsonl_routing.qml",
    "tests/qml/tst_provider_registry.qml",
    "tests/qml/tst_result_store.qml",
    "tests/qml/tst_segmented_navigation.qml",
    "tests/qml/tst_wifi_prompt.qml"
  ],
  "dynamic_component_edges": [
    { "from": "shell/SurfaceRegistry.qml", "to": "shell/SurfaceBundle.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "launcher/ApplicationContent.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "launcher/ApplicationController.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "wifi/WifiContent.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "wifi/WifiPromptController.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "wifi/WifiController.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "bluetooth/BluetoothContent.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "bluetooth/BluetoothController.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "clipboard/ClipboardContent.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "clipboard/ClipboardController.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "activity/ActivityContent.qml" },
    { "from": "shell/SurfaceRegistry.qml", "to": "activity/ActivityController.qml" },
    { "from": "launcher/ApplicationContent.qml", "to": "launcher/ApplicationListPane.qml" },
    { "from": "launcher/ApplicationContent.qml", "to": "launcher/ApplicationDetails.qml" },
    { "from": "launcher/ApplicationListPane.qml", "to": "launcher/ApplicationCategoryTabs.qml" },
    { "from": "launcher/ApplicationDetails.qml", "to": "launcher/ApplicationSettingsPage.qml" },
    { "from": "bluetooth/BluetoothContent.qml", "to": "bluetooth/BluetoothDeviceListPane.qml" },
    { "from": "bluetooth/BluetoothContent.qml", "to": "bluetooth/BluetoothDeviceDetails.qml" },
    { "from": "bluetooth/BluetoothDeviceListPane.qml", "to": "bluetooth/BluetoothDeviceListRow.qml" },
    { "from": "wifi/WifiContent.qml", "to": "wifi/NetworkListPane.qml" },
    { "from": "wifi/WifiContent.qml", "to": "wifi/NetworkDetailsPane.qml" },
    { "from": "clipboard/ClipboardContent.qml", "to": "clipboard/ClipboardListPane.qml" },
    { "from": "clipboard/ClipboardContent.qml", "to": "clipboard/ClipboardDetails.qml" }
  ],
  "output_dir": "target/qmlqualitylens",
  "profile": "quickshell",
  "external_modules": ["QtTest"],
  "external_types": ["GlobalShortcut", "IconImage", "IpcHandler", "PanelWindow", "RectangularShadow", "Region", "Settings", "Shortcut", "SignalSpy", "TestCase", "Variants"],
  "tools": {
    "qmllint": {
      "command": "tests/run-qmlquality-lint.sh",
      "check": true,
      "import_paths": ["qml"]
    },
    "qmltestrunner": {
      "command": "tests/run-qmlquality-tests.sh",
      "check": true,
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    "runtime": {
      "command": "bash",
      "check": true,
      "arguments": ["tests/run-runtime-smoke.sh"],
      "timeout_ms": 30000
    }
  },
  "suppressions": [],
  "exclude": []
}
